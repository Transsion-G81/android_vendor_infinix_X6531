#
# X6531B - TMS/THN31 NFC stack (Infinix HOT 50i with NFC).
#
# Hand-written on purpose: X6531-vendor.mk and Android.bp are generated by
# device/infinix/X6531/{extract-files,setup-makefiles}.py from
# proprietary-files.txt, so the NFC blobs live in their own
# proprietary_x6531b/ directory and are packaged here instead - re-running
# the extract scripts does not touch them.
#
# Only inherited by device/infinix/X6531/device.mk when the lineage_X6531B
# product is being built (the "NFC (X6531B only)" block).  Device tree side:
#   * configs/nfc/*.conf            -> /vendor/etc (HAL + libnfc-nci config;
#                                     libese-tms.conf carries TMS_FW_NAME/
#                                     TMS_NFC_BL_NAME, which resolve to the
#                                     SEC_THN31_FW_VTP.txt.bin committed to
#                                     vendor/etc by the base vendor tree)
#   * configs/nfc/manifest_x6531b.xml -> /vendor/etc/vintf/manifest
#   * rootdir/etc/init.stnfc.rc      -> /vendor/etc/init/hw (services, dirs)
#   * sepolicy/vendor/{file,hwservice}_contexts, hal_nfc_default.te
#   * overlay/NfcResOverlay_X6531B   -> RRO for com.android.nfc
#
# How the stack fits together (everything is the stock X6531B layout):
#   android.hardware.nfc@1.2-service-tms   HIDL 1.2 NFC HAL, init service
#                                          nfc_hal_service.tms, registers
#                                          android.hardware.nfc@1.2::INfc and
#                                          vendor.tms.tmsnfc@1.0::ITmsNfc.
#   nfc_nci.thn31nfc.tms.so                the real TMS/THN31 NCI HAL impl:
#                                          reads /vendor/etc/libnfc-tms*.conf,
#                                          downloads SEC_THN31_FW_VTP.txt.bin
#                                          (already in the base vendor tree),
#                                          keeps NVM state in /data/vendor/nfc
#                                          and talks to /dev/tms_nfc (created
#                                          by nfc_i2c_tms.ko, already in
#                                          modules/modules.load.vendor).
#   tms-utils / tms-cos-dl-*               helpers used by the HAL above.
#   android.hardware.secure_element@1.2-service-mediatek
#                                          MTK SIM/UICC Secure Element HAL;
#                                          com.android.se enumerates its
#                                          SIM1/SIM2 instances from
#                                          configs/nfc/manifest_x6531b.xml.
#   lib64/android.hardware.nfc@1.[0-2].so,
#   lib64/android.hardware.secure_element@1.[0-2].so
#                                          HIDL interface libraries the
#                                          prebuilt HALs need.
#
# The framework side is stock Lineage: NfcNci + libnfc-nci from
# packages/modules/Nfc (shipped by build/make/target/product/base_system.mk)
# pick the HIDL 1.2 HAL up first - see
# NfcAdaptation::InitializeHalDeviceContext - and read the shared
# /vendor/etc/libnfc-nci.conf copied by device.mk.  The TMS forked app
# (NfcNci_tms/libtmsnfc-nci.so) and the NXP snxxx stack that also exist in
# the dump are not used: the X6531B hardware is TMS/THN31 and its driver and
# firmware are the only ones shipped in the stock vendor image.
#

# HALs - cc_prebuilt_binary modules in proprietary_x6531b/Android.bp.
PRODUCT_PACKAGES += \
    android.hardware.nfc@1.2-service-tms \
    android.hardware.secure_element@1.2-service-mediatek

# HIDL interface libraries loaded by the HALs above.
PRODUCT_COPY_FILES += \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/android.hardware.nfc@1.0.so:$(TARGET_COPY_OUT_VENDOR)/lib64/android.hardware.nfc@1.0.so \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/android.hardware.nfc@1.1.so:$(TARGET_COPY_OUT_VENDOR)/lib64/android.hardware.nfc@1.1.so \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/android.hardware.nfc@1.2.so:$(TARGET_COPY_OUT_VENDOR)/lib64/android.hardware.nfc@1.2.so \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/android.hardware.secure_element@1.0.so:$(TARGET_COPY_OUT_VENDOR)/lib64/android.hardware.secure_element@1.0.so \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/android.hardware.secure_element@1.1.so:$(TARGET_COPY_OUT_VENDOR)/lib64/android.hardware.secure_element@1.1.so \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/android.hardware.secure_element@1.2.so:$(TARGET_COPY_OUT_VENDOR)/lib64/android.hardware.secure_element@1.2.so

# TMS/THN31 NFC HAL implementation + the TMS extension HAL.
PRODUCT_COPY_FILES += \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/nfc_nci.thn31nfc.tms.so:$(TARGET_COPY_OUT_VENDOR)/lib64/nfc_nci.thn31nfc.tms.so \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/vendor.tms.tmsnfc@1.0.so:$(TARGET_COPY_OUT_VENDOR)/lib64/vendor.tms.tmsnfc@1.0.so

# Helpers used by nfc_nci.thn31nfc.tms.so.
PRODUCT_COPY_FILES += \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/tms-utils.so:$(TARGET_COPY_OUT_VENDOR)/lib64/tms-utils.so \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/tms-cos-dl-common.so:$(TARGET_COPY_OUT_VENDOR)/lib64/tms-cos-dl-common.so \
    vendor/infinix/X6531/proprietary_x6531b/vendor/lib64/tms-cos-dl-ree.so:$(TARGET_COPY_OUT_VENDOR)/lib64/tms-cos-dl-ree.so
