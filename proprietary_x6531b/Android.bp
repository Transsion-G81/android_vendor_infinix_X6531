//
// X6531B - TMS/THN31 NFC HAL blobs (Infinix HOT 50i with NFC).
//
// Hand-written, NOT generated by device/infinix/X6531/setup-makefiles.py:
// the blobs come from the X6531B stock dump and live next to this file in
// proprietary_x6531b/.  They are only packaged when lineage_X6531B is built
// (X6531B-nfc.mk, inherited by the NFC block in device.mk).
//
// The two HAL executables are declared as cc_prebuilt_binary (instead of
// PRODUCT_COPY_FILES) so soong always installs them with mode 0755 - a git
// checkout on a filesystem that lost the exec bit must not break them.
// The libraries they dlopen/link are plain files copied by X6531B-nfc.mk.
//

cc_prebuilt_binary {
    name: "android.hardware.nfc@1.2-service-tms",
    owner: "infinix",
    target: {
        android_arm64: {
            srcs: [
                "vendor/bin/hw/android.hardware.nfc@1.2-service-tms",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    relative_install_path: "hw",
    soc_specific: true,
}

cc_prebuilt_binary {
    name: "android.hardware.secure_element@1.2-service-mediatek",
    owner: "infinix",
    target: {
        android_arm64: {
            srcs: [
                "vendor/bin/hw/android.hardware.secure_element@1.2-service-mediatek",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    relative_install_path: "hw",
    soc_specific: true,
}
